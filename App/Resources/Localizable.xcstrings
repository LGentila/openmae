    },
    "A relay you host yourself, reachable from the internet. Type its address.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un relais que tu héberges toi-même, joignable depuis internet. Tape son adresse."
