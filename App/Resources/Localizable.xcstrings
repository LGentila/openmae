    "Turn the actions on to choose the permissions and the shortcuts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les actions pour choisir les autorisations et les raccourcis."
          }
        }
      }
    },
    "Turn the memory on to see what Maé remembers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la mémoire pour voir ce que Maé retient."
