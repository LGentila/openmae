          "stringUnit": {
            "state": "translated",
            "value": "Maintiens Espace pour parler"
          }
        }
      }
    },
    "Hold the space bar (or the button at the bottom of the window) while you speak. Useful in noisy places.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la barre d'espace (ou le bouton en bas de la fenêtre) pendant que tu parles. Utile dans un lieu bruyant."
          }
        }
      }
    },
