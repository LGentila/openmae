          }
        }
      }
    },
    "Talk to Maé from your iPhone or iPad": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle à Maé depuis ton iPhone ou ton iPad"
          }
        }
      }
    },
    "Talk to the assistant to see measurements.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle à l’assistant pour voir les mesures."
          }
        }
      }
    },
    "Tasks": {
      "localizations": {
        "fr": {
