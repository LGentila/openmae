    "macOS already uses this shortcut.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS utilise déjà ce raccourci."
          }
        }
      }
    },
    "macOS refuses this shortcut. Choose another one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refuse ce raccourci. Choisis-en un autre."
          }
        }
      }
    },
    "macOS will ask for access the first time you need it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS te demandera l’accès la première fois que tu en auras besoin."
