    "%@ does not answer for now. Next try in a few seconds.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne répond pas pour l’instant. Prochain essai dans quelques secondes."
          }
        }
      }
    },
    "%@ more free space is needed. Free up space on this Mac, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque %@ d’espace libre. Libère de la place sur ce Mac, puis réessaie."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@, your own relay. It only sees encrypted packets. It sends no notifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ton propre relais. Il ne voit que des paquets chiffrés. Il n’envoie pas de notifications."
          }
        }
      }
    },
    "%@. It only sees encrypted packets: neither your voice nor your texts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Il ne voit que des paquets chiffrés : ni ta voix, ni tes textes."
          }
        }
      }
    },
    "%lld min %lld s": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min %lld s"
          }
        }
      }
    },
    "A code is valid for 5 minutes and serves only once.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code vaut 5 minutes et ne sert qu’une fois."
          }
        }
      }
    },
    "A file arrived damaged twice in a row. Check your connection, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier est arrivé abîmé deux fois de suite. Vérifie ta connexion, puis réessaie."
