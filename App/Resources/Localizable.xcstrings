    "Turns": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tours"
          }
        }
      }
    },
    "Type the address of your SearXNG first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape d’abord l’adresse de ton SearXNG."
          }
        }
      }
    },
    "Unexpected answer": {
      "localizations": {
