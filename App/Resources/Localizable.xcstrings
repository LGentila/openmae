    "Choose “OpenMaé relay” to talk to Maé from anywhere.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis « Relais OpenMaé » pour parler à Maé de n’importe où."
