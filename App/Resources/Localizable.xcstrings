    "Claude Code is working on a task. Quitting OpenMaé stops it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code travaille sur une tâche. Quitter OpenMaé l’arrête."
