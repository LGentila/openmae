    "Chosen in the settings (Advanced). Recommended tier for this Mac: %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisi dans les réglages (Avancé). Palier recommandé pour ce Mac : %@."
