      }
    },
    "Claude Code isn’t signed in. Open it once in Terminal to sign in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code n’est pas connecté. Ouvre-le une fois dans le Terminal pour te connecter."
