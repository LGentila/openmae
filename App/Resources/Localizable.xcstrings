            "value": "Injoignable"
          }
        }
      }
    },
    "Untested tier: performance is estimated.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Palier non testé : performances estimées."
          }
        }
      }
    },
    "Used by": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé par"
          }
        }
      }
    },
    "User name": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiant"
          }
        }
      }
    },
    "Valid for another": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valable encore"
          }
        }
      }
    },
    "Voice": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voix"
          }
        }
      }
    },
    "Voice and sound": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voix et son"
          }
        }
      }
    },
    "Voice cut after (median)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voix coupée en (médiane)"
          }
        }
      }
    },
    "Voice dropouts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupures de la voix"
          }
        }
      }
    },
    "Waiting": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente"
          }
        }
      }
    },
    "Waiting for your yes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend ton oui"
          }
        }
      }
    },
    "Weather data by Open-Meteo.com (CC BY 4.0). Rates of the European Central Bank, through Frankfurter. Crypto prices by CoinGecko. Travel times by Apple Maps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données météo d’Open-Meteo.com (CC BY 4.0). Taux de la Banque centrale européenne, par Frankfurter. Cours des cryptomonnaies par CoinGecko. Temps de trajet par Plans d’Apple."
          }
        }
      }
    },
    "Weather, rates and travel times": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Météo, cours et trajets"
          }
        }
      }
    },
    "Welcome home": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour à la maison"
          }
        }
      }
    },
    "What Claude Code may do": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Claude Code peut faire"
          }
        }
      }
    },
    "What Maé can do": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Maé peut faire"
          }
        }
      }
    },
    "What Maé does": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait Maé"
          }
        }
      }
    },
    "What Maé noted of the sentences she heard is erased from this Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Maé a noté des phrases entendues est effacé de ce Mac."
          }
        }
      }
    },
    "What Maé remembers": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Maé retient"
          }
        }
      }
    },
    "What Maé remembers and the history of exchanges are erased from this Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Maé retient et l’historique des échanges sont effacés de ce Mac."
          }
        }
      }
    },
    "What it may do": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’il peut faire"
          }
        }
      }
    },
    "What she heard": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’elle a entendu"
          }
        }
      }
    },
    "What went wrong": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui n’a pas marché"
          }
        }
      }
    },
    "What you hand it leaves this Mac: Claude Code works with Anthropic’s online models.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu lui confies quitte ce Mac : Claude Code travaille avec les modèles en ligne d’Anthropic."
          }
        }
      }
    },
    "What your systems send goes through it to this Mac, which opens no port. Never make it reachable from the internet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tes systèmes envoient passe par lui jusqu’à ce Mac, qui n’ouvre aucun port. Ne le rends jamais joignable depuis internet."
          }
        }
      }
    },
    "When Maé acts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Maé agit"
          }
        }
      }
    },
    "When information arrives": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une info arrive"
          }
        }
      }
    },
    "When it marks something urgent, Maé says it at once, whatever the mode: she may cut her own sentence, never yours. If she cannot speak (announcements off, not ready yet), it shows in a notification and is kept for later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand elle marque une information comme urgente, Maé la dit tout de suite, quel que soit le mode : elle peut couper sa propre phrase, jamais la tienne. Si elle ne peut pas parler (annonces coupées, pas encore prête), l’information s’affiche en notification et est gardée pour plus tard."
          }
        }
      }
    },
    "When she acts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand elle agit"
          }
        }
      }
    },
    "While it is paused, its address answers as if it did not exist.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant qu’elle est en pause, son adresse répond comme si elle n’existait pas."
          }
        }
      }
    },
    "With a token": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un jeton"
          }
        }
      }
    },
    "With headphones there is no echo, so the microphone is used as is. Avoid this mode with speakers: Maé would interrupt herself.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un casque, il n’y a pas d’écho : le micro est utilisé tel quel. Évite ce mode sur les haut-parleurs, Maé se couperait la parole."
          }
        }
      }
    },
    "With my account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec mon compte"
          }
        }
      }
    },
    "With “news: true”, Maé says the text, then the news she kept for you. For example, when you come home:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « nouvelles: true », Maé dit le texte, puis les nouvelles qu’elle a gardées pour toi. Par exemple, quand tu rentres :"
          }
        }
      }
    },
    "Without a key, Maé can’t search. Create a key on Brave’s website, then paste it here: it is kept in your Mac’s keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans clé, Maé ne peut pas chercher. Crée une clé sur le site de Brave, puis colle-la ici : elle est rangée dans le trousseau de ton Mac."
          }
        }
      }
    },
    "Woke up": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réveillée"
          }
        }
      }
    },
    "Wrong method: send with POST, or GET with ?text=.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mauvaise méthode : envoie avec POST, ou GET avec ?text=."
          }
        }
      }
    },
    "You": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toi"
          }
        }
      }
    },
    "You can now talk to Maé from your iPad, at home and away. Keep this Mac on and plugged in so that it stays reachable.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux maintenant parler à Maé depuis ton iPad, à la maison comme ailleurs. Garde ce Mac allumé et branché pour qu’il reste joignable."
          }
        }
      }
    },
    "You can now talk to Maé from your iPad, at home. Keep this Mac on and plugged in so that it stays reachable.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux maintenant parler à Maé depuis ton iPad, à la maison. Garde ce Mac allumé et branché pour qu’il reste joignable."
          }
        }
      }
    },
    "You can now talk to Maé from your iPhone, at home and away. Keep this Mac on and plugged in so that it stays reachable.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux maintenant parler à Maé depuis ton iPhone, à la maison comme ailleurs. Garde ce Mac allumé et branché pour qu’il reste joignable."
          }
        }
      }
    },
    "You can now talk to Maé from your iPhone, at home. Keep this Mac on and plugged in so that it stays reachable.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux maintenant parler à Maé depuis ton iPhone, à la maison. Garde ce Mac allumé et branché pour qu’il reste joignable."
          }
        }
      }
    },
    "You can remove it whenever you want.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras le retirer quand tu veux."
          }
        }
      }
    },
    "You need a Mac with Apple silicon (M1 or later) and at least 8 GB of memory. This Mac: %@, %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut un Mac avec une puce Apple (M1 ou plus récente) et au moins 8 Go de mémoire. Ce Mac : %@, %@."
          }
        }
      }
    },
    "Your %@ account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte %@"
          }
        }
      }
    },
    "Your Brave key has reached its limit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta clé Brave a atteint sa limite."
          }
        }
      }
    },
    "Your Mac has turned off its microphone and speakers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton Mac a coupé son micro et ses haut-parleurs."
          }
        }
      }
    },
    "Your SearXNG asks for a user name and a password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton SearXNG demande un identifiant et un mot de passe."
          }
        }
      }
    },
    "Your SearXNG doesn’t accept programs: turn on its JSON format.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton SearXNG n’accepte pas les programmes : active son format JSON."
          }
        }
      }
    },
    "Your SearXNG takes OpenMaé for a robot: protect it with a password and turn off its bot protection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton SearXNG prend OpenMaé pour un robot : protège-le par un mot de passe et coupe sa protection anti-robots."
          }
        }
      }
    },
    "Your iPhone and iPad reach this Mac at home only, and no source can send from the internet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton iPhone et ton iPad ne joignent ce Mac qu’à la maison, et aucune source ne peut envoyer depuis internet."
          }
        }
      }
    },
    "Your iPhone or iPad cannot wake a sleeping Mac. With the lid closed and no external display, the Mac sleeps anyway.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton iPhone ou ton iPad ne peut pas réveiller un Mac en veille. Capot fermé et sans écran externe, le Mac s’endort quand même."
          }
        }
      }
    },
    "Your iPhone or iPad lends its microphone, its speaker and its screen. Maé always works on your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton iPhone ou ton iPad prête son micro, son haut-parleur et son écran. Maé travaille toujours sur ton Mac."
          }
        }
      }
    },
    "Your own relay": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton propre relais"
          }
        }
      }
    },
    "Your own relay…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton propre relais…"
          }
        }
      }
    },
    "Your relay cannot read what is sent: it stays encrypted up to this Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton relais ne peut pas lire ce qui est envoyé : c’est chiffré jusqu’à ce Mac."
          }
        }
      }
    },
    "Your relay cannot read what is sent: it stays encrypted up to this Mac. The certificate renews by itself (valid until %@).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton relais ne peut pas lire ce qui est envoyé : c’est chiffré jusqu’à ce Mac. Le certificat se renouvelle tout seul (valable jusqu’au %@)."
          }
        }
      }
    },
    "Your relay does not answer. I keep trying.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton relais ne répond pas. Je réessaie toute seule."
          }
        }
      }
    },
    "Your relay does not take information from the internet, so internet sources receive nothing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton relais ne propose pas l’entrée des informations depuis internet, donc les sources d’internet ne reçoivent rien."
          }
        }
      }
    },
    "Your relay does not take information from the internet. Its operator can turn it on (RELAY_INBOUND_DOMAIN).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton relais ne propose pas l’entrée des informations depuis internet. La personne qui le gère peut l’activer (RELAY_INBOUND_DOMAIN)."
          }
        }
      }
    },
    "Your relay does not take information from the internet: this source has no address.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton relais ne propose pas l’entrée des informations depuis internet : cette source n’a pas d’adresse."
          }
        }
      }
    },
    "Your test": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai"
          }
        }
      }
    },
    "Your words and Maé’s answers, to find them again when you ask. Off, nothing is written.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes mots et les réponses de Maé, pour les retrouver quand tu le demandes. Désactivé, rien n’est écrit."
          }
        }
      }
    },
    "action: rest_command.notify_mae\ndata:\n  message: \"Test from Home Assistant\"": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "action: rest_command.prevenir_mae\ndata:\n  texte: \"Essai depuis Home Assistant\""
          }
        }
      }
    },
    "already here": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "déjà là"
          }
        }
      }
    },
    "automation:\n  - alias: \"Back home: Maé welcomes you\"\n    triggers:\n      - trigger: state\n        entity_id: person.<you>\n        to: \"home\"\n    actions:\n      - action: rest_command.notify_mae\n        data:\n          message: \"Good evening, welcome back.\"\n          news: true": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "automation:\n  - alias: \"Retour à la maison : Maé accueille\"\n    triggers:\n      - trigger: state\n        entity_id: person.<toi>\n        to: \"home\"\n    actions:\n      - action: rest_command.prevenir_mae\n        data:\n          texte: \"Bonsoir, bon retour.\"\n          nouvelles: true"
          }
        }
      }
    },
    "end of speech → first sound": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "fin de parole → premier son"
          }
        }
      }
    },
    "iPad added": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad ajouté"
          }
        }
      }
    },
    "iPad · added on %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad · ajouté le %@"
          }
        }
      }
    },
    "iPhone added": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ajouté"
          }
        }
      }
    },
    "iPhone and iPad": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone et iPad"
          }
        }
      }
    },
    "iPhone · added on %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone · ajouté le %@"
          }
        }
      }
    },
    "interrupted": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "interrompu"
          }
        }
      }
    },
    "macOS will ask for access the first time you need it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS te demandera l’accès la première fois que tu en auras besoin."
          }
        }
      }
    },
    "mae_address: \"%@\"": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "adresse_mae: \"%@\""
          }
        }
      }
    },
    "or press": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ou appuie sur"
          }
        }
      }
    },
    "rest_command:\n  notify_mae:\n    # the address copied from OpenMaé\n    url: !secret mae_address\n    method: post\n    content_type: \"application/json\"\n    payload: \"{{ {'text': message, 'news': news | default(false)} | to_json }}\"": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "rest_command:\n  prevenir_mae:\n    # l’adresse copiée depuis OpenMaé\n    url: !secret adresse_mae\n    method: post\n    content_type: \"application/json\"\n    payload: \"{{ {'text': texte, 'news': nouvelles | default(false)} | to_json }}\""
          }
        }
      }
    },
    "tested": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "testé"
          }
        }
