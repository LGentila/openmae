            "value": "non testé / estimé"
          }
        }
      }
    },
    "“Ask first”: Maé says what she is about to do, for example “I turn on the living room”, and waits for your “yes”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Demander d’abord » : Maé dit ce qu’elle va faire, par exemple « j’allume le salon », et attend ton « oui »."
          }
        }
      }
    },
    "“Ask first”: Maé says which shortcut she is about to run and waits for your “yes”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Demander d’abord » : Maé dit quel raccourci elle va lancer et attend ton « oui »."
          }
        }
      }
    },
    "“OK Maé” log": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal de « OK Maé »"
          }
        }
      }
    },
    "“Tokens” are the word pieces the model works with.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Mots » = tokens, les morceaux de mots du modèle."
          }
