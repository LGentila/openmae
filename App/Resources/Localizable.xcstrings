            "state": "translated",
            "value": "Maintiens"
          }
        }
      }
    },
    "Hold the space bar (or the button at the bottom of the window) while you speak. Useful in noisy places.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la barre d’espace (ou le bouton en bas de la fenêtre) pendant que tu parles. Utile dans un lieu bruyant."
          }
        }
      }
    },
    "Hold the space bar to talk": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la barre d’espace pour parler"
          }
        }
      }
    },
    "I can’t make sense of Brave’s answer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne comprends pas la réponse de Brave."
          }
        }
      }
    },
    "I can’t reach Brave.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’arrive pas à joindre Brave."
          }
        }
      }
    },
    "I can’t reach your SearXNG.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’arrive pas à joindre ton SearXNG."
          }
