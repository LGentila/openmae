            "value": "Nom"
          }
        }
      }
    },
    "Name of the new source": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom de la nouvelle source"
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais"
          }
        }
      }
    },
    "New conversation": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle conversation"
          }
        }
      }
    },
    "No answer": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de réponse"
          }
        }
      }
    },
    "No device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil"
          }
        }
      }
    },
    "No relay is on: a source needs one to get its address.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun relais n’est activé : une source en a besoin pour avoir son adresse."
          }
        }
      }
    },
    "No shortcut yet. Put some in an “OpenMaé” folder of the Shortcuts app: Maé will be able to run them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun raccourci pour l’instant. Range-en dans un dossier « OpenMaé » de l’app Raccourcis : Maé pourra les lancer."
          }
        }
      }
    },
    "No source": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune source"
          }
        }
      }
    },
    "No tool connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun outil connecté"
          }
        }
      }
    },
    "None": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun"
          }
        }
      }
    },
    "Not allowed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non autorisés"
          }
        }
      }
    },
    "Not allowed without your OK": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusé sans ton accord"
          }
        }
      }
    },
    "Not enough free space: %@ is needed and %@ is left. Free up space, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a plus assez d’espace libre : il faut %@ et il reste %@. Libère de la place, puis réessaie."
          }
        }
      }
    },
    "Not in home mode": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
