    "Echo cancellation keeps the assistant from hearing itself. Other apps are turned down slightly during the conversation.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'annulation d'écho empêche l'assistant de s'entendre lui-même. Les autres apps sont un peu baissées pendant la conversation."
          }
        }
      }
    },
