            "value": "En cours"
          }
        }
      }
    },
    "In use": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé"
          }
        }
      }
    },
    "Information from home": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations de la maison"
          }
        }
      }
    },
    "Information from the internet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations depuis internet"
          }
        }
      }
    },
    "Instruction": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigne"
          }
        }
