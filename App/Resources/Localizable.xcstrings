  "strings": {
    " · on this Mac": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · sur ce Mac"
          }
        }
      }
    },
    " · untested": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · non testé"
          }
        }
      }
    },
    "%@ (active)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (actif)"
          }
        }
      }
    },
    "%@ (idle)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (au repos)"
          }
        }
      }
    },
    "%@ does not answer for now. Next try in a few seconds.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne répond pas pour l’instant. Prochain essai dans quelques secondes."
          }
        }
      }
    },
    "%@ does not answer. Check that this Mac is on the same network as it, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne répond pas. Vérifie que ce Mac est sur le même réseau que lui, puis réessaie."
          }
        }
      }
    },
    "%@ more free space is needed. Free up space on this Mac, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque %@ d’espace libre. Libère de la place sur ce Mac, puis réessaie."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@ of %@ characters used.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ caractères utilisés sur %2$@."
          }
        }
      }
    },
    "%@ settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages de %@"
          }
        }
      }
    },
    "%@. It only sees encrypted packets. It sends no notifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Il ne voit que des paquets chiffrés. Il n’envoie pas de notifications."
          }
        }
      }
    },
    "%@. It only sees encrypted packets: neither your voice nor your texts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Il ne voit que des paquets chiffrés : ni ta voix, ni tes textes."
          }
        }
      }
    },
