{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant écoute ce que tu dis pour te répondre. Le son ne quitte jamais ce Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant listens to what you say in order to answer. Sound never leaves this Mac."
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMaé"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMaé"
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMaé"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMaé"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maé ajoute à ton calendrier les événements que tu lui demandes, et te le lit quand tu veux savoir ce qui est prévu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maé adds the events you ask for to your calendar and reads it to you when you ask what is planned."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maé ajoute les rappels que tu lui demandes et te lit ceux qui restent à faire."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maé adds the reminders you ask for and reads you those still to do."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton iPhone trouve ce Mac sur ton Wi-Fi pour parler à Maé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone finds this Mac on your Wi-Fi to talk to Maé."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maé se sert de la position de ton Mac pour la météo et les temps de trajet « d’ici », quand tu ne nommes pas d’endroit. Elle ne la garde pas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maé uses your Mac’s location for the weather and the travel times “from here”, when you don’t name a place. She doesn’t keep it."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maé se sert de la position de ton Mac pour la météo et les temps de trajet « d’ici », quand tu ne nommes pas d’endroit. Elle ne la garde pas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maé uses your Mac’s location for the weather and the travel times “from here”, when you don’t name a place. She doesn’t keep it."
          }
        }
      }
    }
  },
  "version": "1.0"
}