    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera reads the code shown on your Mac, once, to pair this device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo lit le code affiché sur ton Mac, une fois, pour associer cet appareil."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMaé finds your Mac on your Wi-Fi to talk to it directly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMaé trouve ton Mac sur ton Wi-Fi pour lui parler directement."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you say goes encrypted to your Mac, and nowhere else."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que tu dis part chiffré vers ton Mac, et nulle part ailleurs."
          }
        }
      }
