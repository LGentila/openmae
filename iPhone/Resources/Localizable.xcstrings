    "Talk to Maé": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parler à Maé"
          }
        }
      }
    },
    "Tap": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher"
          }
