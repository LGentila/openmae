    "%lld min": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        }
      }
    },
    "A code is valid for 5 minutes and serves only once. Show a new one on your Mac: Settings › iPhone and iPad, then “Add a device”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code vaut 5 minutes et ne sert qu’une fois. Affiches-en un nouveau sur ton Mac : Réglages › iPhone et iPad, puis « Ajouter un appareil »."
          }
        }
      }
    },
    "Accessing the microphone…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès au micro…"
          }
        }
      }
    },
    "After a silence, to save the battery": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un silence, pour ménager la batterie"
          }
        }
      }
    },
    "Allow the camera to scan the code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l’appareil photo pour scanner le code."
          }
        }
      }
    },
    "Allow the microphone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise le micro."
